<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ratelimiter</groupId>
        <artifactId>rate-limiter-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>rate-limiter-service</artifactId>
    <name>rate-limiter-service</name>
    <description>The rate limiter Spring Boot application.</description>

    <!-- Managed BOM imports for the integration-test stack (Testcontainers). -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <!-- RATIONALE: pin the whole Testcontainers module set to one line
                     (1.21.x) so core, junit-jupiter and per-image modules never
                     drift apart. Images are parameterized later (M14) via
                     RATE_LIMITER_IMAGE. -->
                <version>1.21.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Lettuce (async, thread-safe Redis/Valkey client) for the production
            backend. We use the raw client with a StatefulRedisConnection rather
            than Spring Data Redis, so the Lua EVALSHA/EVAL fallback (M4) is under
            our control and there is no RedisTemplate auto-config in the path.
            Version is managed by the Spring Boot BOM.
        -->
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
        </dependency>

        <!-- Micrometer Prometheus registry: exposes /actuator/prometheus so the
             service is scrapeable. Version managed by the Spring Boot BOM. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Test scope: JUnit 5, AssertJ, Mockito, TestRestTemplate/WebTestClient. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            jqwik: property-based testing on the JUnit platform. We import the
            aggregate artifact so both the API and the JUnit-platform TestEngine
            are on the test classpath; surefire discovers jqwik properties right
            alongside JUnit 5 tests, with no extra plugin wiring.
        -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>1.10.1</version>
            <scope>test</scope>
        </dependency>

        <!--
            Testcontainers (integration tests): we run against a REAL Valkey
            container, never a mock. junit-jupiter brings the @Testcontainers /
            @Container extension; the core artifact provides GenericContainer and
            the Docker client factory. Versions come from the BOM above.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JMH (micro-benchmarks in src/jmh/java). Provided so they are on the
             compile classpath for the benchmark source set but not bundled into
             the runtime/application. -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>1.37</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>1.37</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- RATIONALE: repackage the bootable jar under an 'exec'
                         classifier so the MAIN artifact stays a plain library jar
                         (classes at the root). This lets the example modules consume
                         the service as a normal dependency (e.g. booting it in a
                         test); without it the bootable jar hides classes under
                         BOOT-INF/ and is unusable as a library. Run via
                         `java -jar ...-exec.jar`. -->
                    <classifier>exec</classifier>
                </configuration>
            </plugin>

            <!--
                Integration test source set (src/integrationTest/java). The tests
                live alongside the unit tests on the test classpath but are named
                *IT so surefire ignores them and failsafe runs them during the
                `integration-test`/`verify` phases. Only Docker is required.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-integration-test-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/integrationTest/java</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-jmh-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/jmh/java</source>
                            </sources>
                        </configuration>
                    </execution>
                    <!--
                        Concurrency source set (src/concurrencyTest/java): proves
                        Lua atomicity by racing many threads through the real HTTP
                        API. Compiled into the same test classpath (so it can reuse
                        the integration base) and run by failsafe (PR-gated).
                    -->
                    <execution>
                        <id>add-concurrency-test-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/concurrencyTest/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Failsafe runs the end-to-end integration tests (*IT) during
                `verify`. It is deliberately a separate plugin from surefire so
                the fast unit/property suite stays PR-time and the slower
                container-backed suite still gates the build. The chaos suite
                (*ChaosIT) is excluded from the default run and gated behind
                -DskipChaosTests=false (nightly only), so it never blocks a PR.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <id>integration-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*IT</include>
                            </includes>
                            <excludes>
                                <exclude>**/*ChaosIT</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <!-- The chaos suite (*ChaosIT) is run only when the 'chaos'
                         Maven profile is active (nightly CI: -P chaos). -->
                </executions>
            </plugin>

            <!--
                JaCoCo is wired from M1 so the CI PR gate has a coverage report
                available immediately. Coverage is a reporting artifact, not a
                gate: we care that the report exists and improves over time
                (target ~85% on core packages is set in later milestones).
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <!-- RATIONALE: Java 25 emits class files at major version 69, which
                     older JaCoCo agents cannot parse (the report step failed with
                     "Unsupported class file major version 69"). 0.8.15 is the first
                     line that understands Java 25 bytecode. -->
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- JMH generates benchmark harness classes via its annotation processor. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>1.37</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Chaos / fault-injection suite. Activated from the nightly CI job
            (`mvn -P chaos verify`) so it never runs as part of the default
            `mvn verify` (the PR gate). The source set is always compiled; only
            the execution is gated here.
        -->
        <profile>
            <id>chaos</id>
            <build>
                <plugins>
                    <!-- Add the chaos source set only when the profile is active, so
                         the default build never even compiles the chaos tests. -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>add-chaos-test-sources</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/chaosTest/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>chaos-tests</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                                <configuration>
                                    <includes>
                                        <include>**/*ChaosIT</include>
                                    </includes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
