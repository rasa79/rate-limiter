<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Multi-module aggregator for the distributed rate-limiter service.
        The concrete application lives in the single-child module "service";
        later milestones add sibling modules (filter, examples, deploy assets).
        RATIONALE: inheriting from spring-boot-starter-parent gives us the
        pluginManagement (compiler, surefire, spring-boot repackaging) and the
        managed dependency versions for free, so every module stays on the
        Spring Boot 4.x line without repeating version pins.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.ratelimiter</groupId>
    <artifactId>rate-limiter-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>rate-limiter-parent</name>
    <description>Centralized, stateless distributed rate-limiting service (Spring Boot 4 + Valkey).</description>

    <modules>
        <module>service</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <!-- RATIONALE: the compile/release target stays aligned with java.version;
             Spring Boot's parent maps java.version onto maven.compiler.release,
             but we pin it here so the generated bytecode target is explicit. -->
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
</project>
