{
  "title": "Rate Limiter",
  "uid": "rate-limiter",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Checks/sec (by result)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ratelimiter_checks_total[1m])) by (result)",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rejection rate ratio",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ratelimiter_checks_total{result=\"rejected\"}[5m])) / sum(rate(ratelimiter_checks_total[5m]))",
          "legendFormat": "rejection",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Valkey latency p99",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(ratelimiter_valkey_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Valkey unavailable (rate)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(ratelimiter_redis_unavailable_total[5m])",
          "legendFormat": "unavailable",
          "refId": "A"
        }
      ]
    }
  ]
}
